<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_item_background"
    android:layoutDirection="rtl">

    <ImageView
        android:id="@+id/widget_item_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_launcher"
        android:contentDescription="تیک یادآور" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/widget_item_priority"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/widget_add_btn_bg" />
</LinearLayout>
